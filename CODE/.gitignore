# =========================================================
# InvestWise AI - Git Ignore
# =========================================================

# -------------------------
# Environment variables
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Python cache
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# -------------------------
# Virtual environments
# -------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# -------------------------
# Python packaging
# -------------------------
*.egg
*.egg-info/
dist/
build/
.eggs/

# -------------------------
# Testing / coverage
# -------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# -------------------------
# Type checking
# -------------------------
.mypy_cache/
.pyre/
.pytype/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# SQLite databases
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.bak
*.backup

# -------------------------
# AI / ML generated files
# -------------------------
models/
checkpoints/
weights/
*.pt
*.pth
*.onnx
*.h5
*.keras
*.safetensors

# -------------------------
# Generated analysis files
# -------------------------
outputs/
results/
reports/
generated/
uploads/

# -------------------------
# Cache
# -------------------------
.cache/
.streamlit/
.gradio/

# -------------------------
# Node / Frontend
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Build files
# -------------------------
dist/
build/

# -------------------------
# Local project files
# -------------------------
*.local
*.secret

# -------------------------
# Backup files
# -------------------------
*.zip
*.rar
*.7z

# -------------------------
# Windows
# -------------------------
$RECYCLE.BIN/